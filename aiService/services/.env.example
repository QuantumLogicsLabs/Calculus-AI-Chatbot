# Loaded from aiService/services/.env; real environment variables take priority.
# True = explicit placeholder demo with no paid model calls.
# For real tutoring set False and supply your own Groq key locally.
USE_MOCK=True
GROQ_API_KEY=

# Current provider: https://api.groq.com/openai/v1
# Current model: openai/gpt-oss-120b (configured in llm_client.py).
# GROK_API_KEY (xAI) is not a substitute for GROQ_API_KEY.
GROQ_MODEL=openai/gpt-oss-120b
PRIMARY_TIMEOUT_SECONDS=12
STREAM_TOTAL_TIMEOUT_SECONDS=40
LLM_CACHE_TTL_SECONDS=300
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_SECONDS=60

# Optional comma-separated extra origins for direct browser-to-AI access.
ALLOWED_AI_ORIGINS_EXTRA=
