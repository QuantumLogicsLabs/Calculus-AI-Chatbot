# Load locally with: python -m uvicorn backend.app.main:app --env-file backend/.env --port 8002
# A hosted backend must use the reachable AI service URL, not localhost
# when the AI service runs in a different container.
AI_SERVICE_URL=http://127.0.0.1:8001

# Comma-separated extra frontend origins, without trailing slashes.
# localhost:3000 and 127.0.0.1:3000 are already allowed.
ALLOWED_ORIGINS_EXTRA=
