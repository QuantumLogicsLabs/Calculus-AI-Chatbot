# Production backend URL — used by react-scripts build automatically.
# Must NOT have a trailing slash.
# B-2 fix: this project uses Vite, which ONLY reads env vars prefixed
# with VITE_ at build time. REACT_APP_API_URL (a Create React App
# convention) is silently ignored by Vite — this was the real reason
# chatApi.js kept falling back to http://127.0.0.1:8002 in production.
REACT_APP_API_URL=https://calculus.quantumlogicslimited.com
VITE_API_URL=https://calculus.quantumlogicslimited.com