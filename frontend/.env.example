# Read by react-scripts at start/build time. Restart after changing values.
# Browser-visible settings only: never put API keys or secrets here.
REACT_APP_API_URL=http://127.0.0.1:8002

# Leave empty to use the backend above (sessions, feedback and progress).
# Optional direct AI service base URL; /chat/ is appended by the client.
REACT_APP_CHAT_URL=
